# ─────────────────────────────────────────────────────────────────────────────
# FindLocal — example environment file
#
# Copy this file to `.env` (same folder) and fill in real values:
#     cp .env.example .env
# `.env` is git-ignored — NEVER commit real secrets.
# The server validates all of these at startup and refuses to boot when a
# required value is missing, weak, or a placeholder.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── Database ─────────────────────────────────────────────────────────────────
# Required. Must start with mongodb:// or mongodb+srv://
MONGO_URI=mongodb://localhost:27017/findlocal

# ── CORS ─────────────────────────────────────────────────────────────────────
# Required. Comma-separated list of allowed frontend origins.
# A wildcard ("*") is rejected because credential-carrying cookies are enabled.
CORS_ORIGIN=http://localhost:5173

# ── JWT ──────────────────────────────────────────────────────────────────────
# Required. Must be at least 32 characters and must NOT be a placeholder
# (the value below is intentionally rejected — replace it).
# Generate a strong secret with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

# ── Reservation expiry sweep (optional) ──────────────────────────────────────
# Background sweep that releases held stock for expired reservations.
# Disabled automatically when NODE_ENV=test.
EXPIRY_SWEEP_INTERVAL_MS=60000
EXPIRY_SWEEP_LIMIT=200

# ── Rate limiting (optional) ─────────────────────────────────────────────────
# Positive integers. These bound abusive traffic (HTTP 429 when exceeded):
#   RATE_LIMIT_API_MAX         — every /api/v1 request
#   RATE_LIMIT_AUTH_MAX        — login + register (credential guessing)
#   RATE_LIMIT_RESERVATION_MAX — reservation creation (POST /api/v1/reservations)
# Defaults are used when unset; under NODE_ENV=test they are relaxed so the
# isolated test suites are not throttled.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_API_MAX=300
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_RESERVATION_MAX=20
